[Unit]
Description=Yizhi License Server
After=network.target

[Service]
Type=simple
User=www-data
WorkingDirectory=/opt/yizhi-license-server
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/yizhi-license-server/.venv/bin/python -m app.main
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
