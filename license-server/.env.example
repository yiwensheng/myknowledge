# 易知授权服务（部署在云主机，勿放入用户安装包）

LICENSE_PORT=18888
LICENSE_DB=license.db

# JWT 签名密钥（生产环境请换成长随机串）
LICENSE_JWT_SECRET=change-me-to-a-long-random-secret

# 管理接口密钥
LICENSE_ADMIN_KEY=change-me-admin-key

# 套餐价格（元）— 易知
LICENSE_PRICE_MONTH=29
LICENSE_PRICE_YEAR=299
LICENSE_PRICE_LIFETIME=199

# 套餐价格（元）— 周易卦象（独立定价）
LICENSE_PRICE_ZHOUYI_MONTH=9.9
LICENSE_PRICE_ZHOUYI_YEAR=39.9
LICENSE_PRICE_ZHOUYI_LIFETIME=99.9

# 自助换机次数 / 年
LICENSE_UNBIND_PER_YEAR=1

# 虎皮椒（xunhupay）https://www.xunhupay.com/
XUNHUPAY_APPID=
XUNHUPAY_APPSECRET=
XUNHUPAY_GATEWAY=https://api.xunhupay.com/payment/do.html
# 主网关不可达时可试备用：https://api.dpweixin.com/payment/do.html
# Windows 服务器若报 SSL CERTIFICATE_VERIFY_FAILED（代理/VPN 劫持证书），可设 0：
# XUNHUPAY_SSL_VERIFY=0
# 支付成功回调 URL（公网可访问）
XUNHUPAY_NOTIFY_URL=https://license.your-domain.com/pay/xunhupay/notify
# 支付完成后跳转（可选）
XUNHUPAY_RETURN_URL=

# 用户反馈邮件（客户端 → 本服务代发）
# 优先 SMTP；未配 SMTP 时尝试本机已登录的 agently-cli（suddly@agent.qq.com）
FEEDBACK_ENABLED=1
FEEDBACK_TO=ywsay@126.com
FEEDBACK_FROM=suddly@agent.qq.com
# FEEDBACK_SMTP_HOST=smtp.qq.com
# FEEDBACK_SMTP_PORT=465
# FEEDBACK_SMTP_SSL=1
# FEEDBACK_SMTP_USER=suddly@agent.qq.com
# FEEDBACK_SMTP_PASSWORD=
