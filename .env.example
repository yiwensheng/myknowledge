# Myknowledge LLM 配置示例（复制为 .env 后填写）

MYKNOWLEDGE_LLM_API_BASE=https://api.emmm204.site:4170/v1
MYKNOWLEDGE_LLM_API_KEY=your-api-key-here
MYKNOWLEDGE_LLM_MODEL=qwen3.6

MYKNOWLEDGE_LLM_TEMPERATURE_ASK=0.15
MYKNOWLEDGE_LLM_TEMPERATURE_PRODUCE=0.35
# MYKNOWLEDGE_LLM_MAX_TOKENS_PRODUCE=8192

# 提示词与人设：编辑 prompts/persona.md、prompts/produce.md、prompts/ask.md
# MYKNOWLEDGE_PROMPTS_DIR=prompts

# 兼容 LearnMate 等项目的变量名（优先级低于 MYKNOWLEDGE_*）
# LLM_BASE_URL=https://api.emmm204.site:4170/v1
# LLM_API_KEY=
# LLM_MODEL=qwen3.6

MYKNOWLEDGE_PORT=18765

# 外联目录（只读 RAG，不复制；推荐在 GUI「导入资料 → 外联文档目录」添加）
# MYKNOWLEDGE_EXTRA_DIRS=D:\Docs\参考;D:\Projects\notes
# MYKNOWLEDGE_LINKED_DIRS_AUTO_INDEX=1
# MYKNOWLEDGE_LINKED_DIRS_POLL=60

# GUI 工作流默认不扫描 Cursor 全局 Skill（仅易知 skills/ 目录）
# MYKNOWLEDGE_INCLUDE_CURSOR_SKILLS=0

# 越用越聪明：连续对话 + 有依据问答自动归档
MYKNOWLEDGE_ASK_REMEMBER=1
MYKNOWLEDGE_AUTO_ARCHIVE_QA=1
MYKNOWLEDGE_MEMORY_TURNS=6    # 追问时注入 LLM 的最近 N 轮（0=全部；SQLite/文件均不限存储轮数）
MYKNOWLEDGE_MEMORY_QA=3

# RAG 检索片段数（越大越全但略慢；标题命中加权 1.35×）
MYKNOWLEDGE_RAG_TOP_ASK=6
MYKNOWLEDGE_RAG_TOP_PRODUCE=8

# RAG 模式：keyword（仅词频）| vector | hybrid（默认）| external（仅 AnythingLLM 检索）
MYKNOWLEDGE_RAG_MODE=hybrid
# 混合检索权重（DocuBrowser 默认约 0.3 词频 + 0.7 向量；也可用 MYKNOWLEDGE_RAG_HYBRID_MAX=1 取 max 合并）
MYKNOWLEDGE_RAG_HYBRID_KEYWORD=0.35
MYKNOWLEDGE_RAG_HYBRID_VECTOR=0.65
# MYKNOWLEDGE_RAG_HYBRID_MAX=1
MYKNOWLEDGE_RAG_CHUNK_SIZE=520
MYKNOWLEDGE_RAG_CHUNK_OVERLAP=80

# 从知识库学习语气/句式，注入问答与产出（默认开启）
# MYKNOWLEDGE_STYLE_ENABLED=1
# MYKNOWLEDGE_STYLE_SAMPLE_PAGES=18
# MYKNOWLEDGE_STYLE_LLM_DISTILL=1
# MYKNOWLEDGE_STYLE_REFRESH_HOURS=24

# 写文章增强（随 skills/ 进安装包；默认开；不依赖 Cursor）
# MYKNOWLEDGE_NO_AI_SLOP=1
# MYKNOWLEDGE_HUMAN_WRITING=1
# MYKNOWLEDGE_DZS=1
# MYKNOWLEDGE_BASB=1
# MYKNOWLEDGE_DE_AI_WRITING=1

# 入库时 LLM 分析文档/URL/粘贴文本（默认：有 API Key 则开启）
# MYKNOWLEDGE_INGEST_ANALYZE=1
# MYKNOWLEDGE_INGEST_ANALYZE_MAX_CHARS=14000

# 批量整理 inbox 并行 worker 数（0=自动，约 CPU 核数一半）
# MYKNOWLEDGE_INGEST_WORKERS=4
# 批量上传默认跳过 LLM 入库分析（更快）；设为 1 则批量也做 LLM 分析
# MYKNOWLEDGE_INGEST_BATCH_ANALYZE=0

# 内置 DocuBrowser（third_party/DocuBrowser，GPL-3.0；克隆后自动启用，无需单独安装）
# MYKNOWLEDGE_DOCUBROWSER_ENABLED=1
# MYKNOWLEDGE_DOCUBROWSER_PORT=18766
# MYKNOWLEDGE_DOCUBROWSER_URL=http://127.0.0.1:18766
# MYKNOWLEDGE_DOCUBROWSER_AUGMENT=1
# 导入/更新检索库后后台自动索引 assets（无需界面操作，默认开启）
# MYKNOWLEDGE_DOCUBROWSER_AUTO_RESCAN=1
# MYKNOWLEDGE_DOCUBROWSER_RESCAN_EMBED=0
# 设为 0 可关闭；未设置时：已内置则自动启用
# MYKNOWLEDGE_DOCUBROWSER_CLI=auto

# 向量 embedding（OpenAI 兼容 /v1/embeddings；默认与 LLM 同 base/key）
# MYKNOWLEDGE_EMBEDDING_API_BASE=
# MYKNOWLEDGE_EMBEDDING_API_KEY=
MYKNOWLEDGE_EMBEDDING_MODEL=text-embedding-3-small

# Rerank 精排（默认同 Embedding API base + /rerank；与 LLM/Embedding 共用 Key）
# MYKNOWLEDGE_RERANK=1
# MYKNOWLEDGE_RERANK_URL=
# MYKNOWLEDGE_RERANK_MODEL=bge-reranker-v2-m3

# 可选工具：python scripts/setup_optional_tools.py 安装内置 ffmpeg / bun
# MYKNOWLEDGE_FFMPEG_PATH=
# MYKNOWLEDGE_BUN_PATH=
# BAOYU_FETCH_PATH=

# 可选：AnythingLLM 外联 RAG（vector-search 增补；chat_fallback=本地无命中时走 workspace query）
# MYKNOWLEDGE_ANYTHINGLLM_URL=http://127.0.0.1:3001
# MYKNOWLEDGE_ANYTHINGLLM_API_KEY=
# MYKNOWLEDGE_ANYTHINGLLM_WORKSPACE=myknowledge
# MYKNOWLEDGE_ANYTHINGLLM_AUGMENT=0
# MYKNOWLEDGE_ANYTHINGLLM_CHAT_FALLBACK=0
# MYKNOWLEDGE_ANYTHINGLLM_SCORE_THRESHOLD=0.2

# 订阅授权（分发给用户时配置；开发自用可留空或设 MYKNOWLEDGE_LICENSE_REQUIRED=0）
# MYKNOWLEDGE_LICENSE_SERVER=https://license.your-domain.com
# MYKNOWLEDGE_LICENSE_JWT_SECRET=与授权服务 LICENSE_JWT_SECRET 相同
# MYKNOWLEDGE_LICENSE_REQUIRED=1
# MYKNOWLEDGE_LICENSE_ADMIN_KEY=仅开发/mock 支付用，勿放入用户包

# 手动迁移旧 JSON/jsonl：python scripts/migrate_memory_db.py

# Skills 目录（分号分隔；默认含 skills/ 与 ~/.cursor/skills）
# MYKNOWLEDGE_SKILLS_DIRS=
# MYKNOWLEDGE_INCLUDE_CURSOR_SKILLS=1
# MYKNOWLEDGE_INCLUDE_AGENTS_SKILLS=0

# Loop Engineering（https://github.com/cobusgreyling/loop-engineering）
MYKNOWLEDGE_LOOP_LEVEL=1
MYKNOWLEDGE_LOOP_WEEK_ONE=1
# MYKNOWLEDGE_LOOP_AUTO_ACT=1
# MYKNOWLEDGE_LOOP_WEEK_ONE=0   # 关闭 week-one 后可跑 L2/L3

# 检查更新（关于 → 检查更新；JSON 含 version、download_url、release_notes）
# MYKNOWLEDGE_UPDATE_URL=https://你的域名/yizhi/latest.json

# PDF 结构化（表格 / 版面）
# MYKNOWLEDGE_PDF_TABLES=1
# MYKNOWLEDGE_PDF_LAYOUT=1
# MYKNOWLEDGE_PDF_LAYOUT_MAX_PAGES=40
# MYKNOWLEDGE_PDF_LAYOUT_DIR=
# MYKNOWLEDGE_PDF_OCR=1
# MYKNOWLEDGE_PDF_OCR_DPI=160
