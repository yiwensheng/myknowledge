# 易知用户配置（安装后复制为 .env）
# 构建便携包时会从开发机 .env 注入大模型/RAG 配置，并设置 MYKNOWLEDGE_HIDE_LLM_SETTINGS=1

# === 大模型（构建时注入，设置页不显示）===
MYKNOWLEDGE_HIDE_LLM_SETTINGS=1
MYKNOWLEDGE_LLM_API_BASE=https://你的LLM服务/v1
MYKNOWLEDGE_LLM_API_KEY=
MYKNOWLEDGE_LLM_MODEL=gpt-4o-mini
MYKNOWLEDGE_LLM_TEMPERATURE_ASK=0.15
MYKNOWLEDGE_LLM_TEMPERATURE_PRODUCE=0.35

# === 订阅（安装包预填，一般勿改）===
MYKNOWLEDGE_LICENSE_REQUIRED=1
MYKNOWLEDGE_LICENSE_SERVER=https://www.yzwhysxx.cn/license
MYKNOWLEDGE_LICENSE_JWT_SECRET=构建时注入-与授权服务器相同

# === 帮助链接（可选，关于页「购买说明」「常见问题」）===
MYKNOWLEDGE_HELP_PURCHASE_URL=https://www.yzwhysxx.cn/yizhi/purchase.html
MYKNOWLEDGE_HELP_FAQ_URL=https://www.yzwhysxx.cn/yizhi/faq.html
MYKNOWLEDGE_HELP_CHANGELOG_URL=https://www.yzwhysxx.cn/yizhi/changelog.html

# === 可选 ===
MYKNOWLEDGE_PORT=18765
MYKNOWLEDGE_UPDATE_URL=https://www.yzwhysxx.cn/yizhi/latest.json

# 详见 docs/commercial/FAQ.md
